# Copy this file to .env in the backend/ folder and fill in your keys.
# .env is gitignored — never commit real keys.

# Flip to "live" once at least one key below is set. Leaving this on
# "mock" (or leaving both keys blank) keeps the app fully demoable with
# canned responses — nothing breaks either way.
LLM_MODE=mock

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — override the default models. Check current model names at
# https://docs.claude.com/en/docs/about-claude/models (Anthropic) and
# https://platform.openai.com/docs/models (OpenAI) since these change.
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini

# You only need ONE key for the app to work. With one key, that provider's
# answer is used directly (no cross-check). With both keys, the Verified
# Knowledge Engine actually cross-checks the two providers and a judge call
# reconciles any disagreement — this is the real HLD 6.1 behavior, not a
# simplification.
