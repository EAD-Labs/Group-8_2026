# Copy this file to .env in the backend/ folder and fill in what you need.
# .env is gitignored — never commit real keys.

# ─── AI providers ──────────────────────────────────────────────────────────
# Flip to "live" once at least one key below is set. Leaving this on "mock"
# (or leaving the keys blank) keeps the app fully demoable with canned
# responses — nothing breaks either way, and the whole test suite runs.
LLM_MODE=mock

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which providers to actually call. Set this to match the keys you have —
# listing one with no key costs a failed HTTP request per call before the
# per-provider fallback catches it.
# LLM_PROVIDERS=["gemini"]

# Optional — override the default models. Check current model names at
# https://docs.claude.com/en/docs/about-claude/models (Anthropic) and
# https://platform.openai.com/docs/models (OpenAI) since these change.
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-flash-latest

# The cheap model for the "run" tier — dialogue turns, learner answers, grading,
# the baseline arm. The strong model above is used only for the "build" tier:
# record compilation and adjudication, which are cached per concept and so run
# roughly ten times for the whole pilot.
#
# On a free Gemini key this is not just a cost optimisation. The daily request
# quota is PER MODEL (the free tier allows only 20 requests/day/model), so
# splitting the tiers across two models doubles what a day of demoing can do,
# and exhausting one tier does not take out the other.
# GEMINI_MODEL_FAST=gemini-3.1-flash-lite

# Retries for transient 429/5xx. A rate-limited key returns these constantly,
# and one session makes many calls; without retries live mode silently falls
# back to templates while still reporting itself as live.
# LLM_MAX_RETRIES=4

# ONE key makes the app work. TWO DIFFERENT MODEL FAMILIES are what make
# cross-provider verification mean anything — the gains come from
# heterogeneity, not from more calls to the same family, and with a single
# provider no disagreement can be detected at all (which is why HLD T1.2
# cannot pass on one key). A gateway credential (LiteLLM in code, OpenRouter
# as the endpoint) gives several families from one key; see PROJECT.md §6.

# ─── Deployment ────────────────────────────────────────────────────────────
# Set before deploying anywhere. "dev" is also what allows create_all to run
# at startup; anything else leaves the schema entirely to Alembic.
# ENV=dev

# JSON list. Must include the exact origin the frontend is served from, or
# every request fails CORS.
# CORS_ALLOW_ORIGINS=["https://your-frontend.example.com"]

# SQLite by default. For Postgres, also install requirements-postgres.txt,
# and run `alembic upgrade head` before first boot.
# DATABASE_URL=postgresql://user:pass@host:5432/aikyro

# CHANGE THIS before any deployment — the default is a known value, so
# leaving it means anyone can mint a valid token for any learner.
# JWT_SECRET=

# ─── Study parameters (HLD 6.3, 6.6) ──────────────────────────────────────
# Equal time budget per concept, applied to BOTH arms. Recorded on each
# session at creation, so changing it cannot retroactively alter what a
# completed session was given.
# SESSION_TIME_BUDGET_SECONDS=1200

# Mean rubric score needed to pass a checkpoint.
# CHECKPOINT_PASS_THRESHOLD=0.6

# Delay window before a retention check unlocks. Never same-day (HLD 6.6).
# RETENTION_DELAY_DAYS_MIN=3
# RETENTION_DELAY_DAYS_MAX=5

# ─── Voice (HLD 6.3, 10.6) ────────────────────────────────────────────────
# The transcriber is mocked pending the D1 feasibility spike. While it is
# "mock", teach-back scoring works against a canned transcript and voice
# dictation returns 503 rather than passing that canned string off as the
# learner's words.
# VOICE_ENABLED=true
# SPEECH_PROVIDER=mock
